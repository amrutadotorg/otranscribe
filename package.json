{
  "name": "otranscribe",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:locale": "node scripts/build-locale.mjs",
    "build:server": "tsc --project tsconfig.node.json",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b",
    "knip": "knip",
    "server": "node dist-server/index.js",
    "dev:server": "NODE_ENV=development node dist-server/index.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "~29.1.1",
    "knip": "^6.29.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "ejs": "^6.0.1"
  }
}
